#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    combos {
        compatible = "zmk,combos";
        combo_lgui_space {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp LG(SPACE)>;
        };
    };

    macros {
        xtips: xtips {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(X) &kp DOT &kp LS(T) &kp I &kp P &kp S>;
            wait-ms = <1>;
            tap-ms = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp PLUS  &kp Q  &kp W  &kp E    &kp R     &kp T           &kp Y           &kp U     &kp I     &kp O    &kp P      &kp MINUS
            &kp EQUAL &kp A  &kp S  &kp D    &kp F     &kp G           &kp H           &kp J     &kp K     &kp L    &sk LCTRL  &kp ENTER
            &kp GRAVE &kp Z  &kp X  &kp C    &kp V     &kp B           &kp N           &kp M     &kp COMMA &kp DOT  &kp SLASH  &kp BSLH
            &none     &none  &none  &sk LALT &lt 1 ESC &mt LSHFT SPACE &mt LSHFT SPACE &lt 2 TAB &sk LGUI  &none    &none      &none
            >;
        };

        fn1_layer {
            bindings = <
            &trans  &trans &kp AMPS &kp ASTRK &trans    &trans   &trans   &kp N7 &kp N8 &kp N9 &trans   &trans
            &trans  &trans &kp DLLR &kp PRCNT &kp CARET &trans   &trans   &kp N4 &kp N5 &kp N6 &kp SEMI &kp LS(SEMI)
            &mo 3   &trans &kp EXCL &kp AT    &kp HASH  &trans   &trans   &kp N1 &kp N2 &kp N3 &trans   &bootloader
            &none   &none  &none    &trans    &trans    &kp BSPC &kp BSPC &kp N0 &trans &none  &none    &none
            >;
        };

        fn2_layer {
            bindings = <
            &kp F1 &kp F2       &kp F3    &kp F4       &kp F5   &kp F6   &kp F7   &kp F8   &kp F9  &kp F10   &kp F11  &kp F12
            &trans &kp LS(SEMI) &kp LBKT  &kp LBRC     &kp LPAR &kp SEMI &kp LEFT &kp DOWN &kp UP  &kp RIGHT &kp HOME &kp END
            &trans &trans       &kp RBKT  &kp RBRC     &kp RPAR &trans   &trans   &trans   &trans  &trans    &trans   &trans
            &none  &none        &none     &kp LC(TAB)  &kp DQT  &kp SQT  &trans   &trans   &trans  &none     &none    &none
            >;
        };

        fn3_layer {
            bindings = <
            &none &none &none       &none &none &none &none    &none  &none  &none  &none &none
            &none &none &none       &none &none &none &none    &none  &none  &none  &none &none
            &none &kp A &bootloader &none &none &none &none    &none  &none  &none  &bootloader &none
            &none &none &none       &none &none &studio_unlock &none  &none  &xtips &none &none &none
            >;
        };

        fn4_layer {
            bindings = <
            &none &none &none &none &none &none &none &none &none &none &none &none
            &none &none &none &none &none &none &none &none &none &none &none &none
            &none &none &none &none &none &none &none &none &none &none &none &none
            &none &none &none &none &none &none &none &none &none &none &none &none
            >;
        };

        fn5_layer {
            bindings = <
            &none &none &none &none &none &none &none &none &none &none &none &none
            &none &none &none &none &none &none &none &none &none &none &none &none
            &none &none &none &none &none &none &none &none &none &none &none &none
            &none &none &none &none &none &none &none &none &none &none &none &none
            >;
        };
    };
};
